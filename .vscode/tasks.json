{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Iniciar backend Django",
			"type": "shell",
			"command": "backend/.venv/Scripts/python.exe",
			"args": [
				"backend/manage.py",
				"runserver",
				"127.0.0.1:8000"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Iniciar frontend Vite local",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
